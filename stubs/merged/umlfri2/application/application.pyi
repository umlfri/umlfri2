class MetaApplication(type):
    def __call__(cls): ...

class Application(metaclass=MetaApplication):
    def __init__(self) -> None: ...
    @property
    def about(self): ...
    def start(self) -> None: ...
    def init_after_main_window_shown(self) -> None: ...
    def stop(self) -> None: ...
    def use_args(self, args) -> None: ...
    def use_ruler(self, ruler) -> None: ...
    def use_thread_manager(self, thread_manager) -> None: ...
    @property
    def ruler(self): ...
    @property
    def thread_manager(self): ...
    @property
    def event_dispatcher(self): ...
    @property
    def commands(self): ...
    @property
    def solution(self): ...
    @property
    def addons(self): ...
    @property
    def tabs(self): ...
    @property
    def unsaved(self): ...
    @property
    def change_status(self): ...
    @property
    def templates(self) -> Generator[Incomplete, Incomplete]: ...
    @property
    def recent_files(self) -> Generator[Incomplete, Incomplete]: ...
    @property
    def solution_name(self): ...
    def new_project(self, template, new_solution: bool = True, project_name: str = 'Project') -> None: ...
    def is_valid_save_file(self, filename): ...
    @property
    def should_save_as(self): ...
    @property
    def can_save_solution(self): ...
    def save_solution(self) -> None: ...
    @property
    def can_save_solution_as(self): ...
    def save_solution_as(self, filename) -> None: ...
    def open_solution_in_steps(self, filename) -> Generator[Incomplete]: ...
    def open_solution(self, filename) -> None: ...
    def close_solution(self) -> None: ...
    @property
    def language(self): ...
    @property
    def config(self): ...
    @property
    def selected_item(self): ...
    def select_item(self, element) -> None: ...
    @property
    def clipboard_empty(self): ...
    @property
    def clipboard(self): ...
    @clipboard.setter
    def clipboard(self, value) -> None: ...
